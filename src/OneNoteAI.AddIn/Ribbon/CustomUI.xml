<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnRibbonLoad">
  <ribbon>
    <tabs>
      <tab id="tabOneNoteAI" label="AI 助手" insertAfterMso="TabHome">
        <group id="grpOneNoteAI" label="AI 助手">
          <button id="btnSummarize" label="摘要" onAction="OnSummarize" size="large" imageMso="ReviewAcceptChange" screentip="智能摘要" supertip="使用 AI 对当前页面或分区内容进行摘要"/>
          <button id="btnGenerate" label="生成" onAction="OnGenerate" size="large" imageMso="FileNew" screentip="生成内容" supertip="根据提示词使用 AI 生成笔记内容"/>
          <button id="btnRewrite" label="改写" onAction="OnRewrite" size="large" imageMso="Cut" screentip="智能改写" supertip="使用 AI 改写或润色当前页面的文本"/>
          <button id="btnQA" label="问答" onAction="OnQA" size="large" imageMso="ResearchPane" screentip="智能问答" supertip="基于当前页面或整个分区内容向 AI 提问，支持跨页检索和来源引用"/>
          <button id="btnTranslate" label="翻译" onAction="OnTranslate" size="large" imageMso="TranslateMenu" screentip="智能翻译" supertip="使用 AI 翻译选中文本或当前页面内容"/>
          <button id="btnExtractTodos" label="提取待办" onAction="OnExtractTodos" size="large" imageMso="Paste" screentip="提取待办事项" supertip="使用 AI 从当前页面或整个分区中提取行动项和待办事项"/>
          <button id="btnSettings" label="设置" onAction="OnSettings" size="large" imageMso="FileSave" screentip="插件设置" supertip="配置 Deepseek API Key 和其他选项"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>


